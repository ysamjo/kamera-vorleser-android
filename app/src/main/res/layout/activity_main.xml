<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:contentDescription="Kamerabild: Tippen setzt den Fokus, langes Drücken aktiviert Autofokus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <View
        android:id="@+id/cameraShade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/camera_shade"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/storyTopGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.74" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/storyLeftGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.23" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/storyRightGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.77" />

    <View
        android:id="@+id/storyRegion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/story_region_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/storyRightGuide"
        app:layout_constraintStart_toStartOf="@id/storyLeftGuide"
        app:layout_constraintTop_toTopOf="@id/storyTopGuide" />

    <LinearLayout
        android:id="@+id/storyRegionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/story_label_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        app:layout_constraintStart_toStartOf="@id/storyLeftGuide"
        app:layout_constraintTop_toTopOf="@id/storyTopGuide">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="Story-Erkennung"
            android:src="@drawable/ic_spark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-rounded"
            android:letterSpacing="0.08"
            android:text="STORY-ZONE  •  BLAUE DIALOGE AUTOMATISCH"
            android:textColor="@color/navy_ink"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/hud_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/emblem_background"
            android:padding="7dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Pokopia Story-Vorleser"
                android:src="@drawable/ic_story_lens" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-rounded"
                android:letterSpacing="0.04"
                android:text="POKOPIA"
                android:textColor="@color/gold"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-rounded"
                android:letterSpacing="0.12"
                android:text="STORY-VORLESER"
                android:textColor="@color/sky"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speechButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/speech_settings"
            android:textColor="@color/navy_ink"
            android:textSize="12sp"
            app:backgroundTint="@color/gold"
            app:cornerRadius="11dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoomButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/camera_selection"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-rounded"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="1.0x"
            android:textColor="@color/navy_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gold"
            app:cornerRadius="11dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_background"
            android:ellipsize="end"
            android:fontFamily="sans-serif-rounded"
            android:maxLines="1"
            android:maxWidth="330dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="●  Pokopia-Kamera wird gestartet …"
            android:textColor="@color/leaf"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialogPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/dialog_card_background"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="15dp"
        app:layout_constraintEnd_toStartOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topPanel">

        <TextView
            android:id="@+id/speakerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/speaker_chip_background"
            android:fontFamily="sans-serif-rounded"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="BEREIT"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recognizedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-rounded"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="Die Pokopia-Dialogbox in die goldene Story-Zone halten."
            android:textColor="@color/navy_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-rounded"
            android:text=""
            android:textColor="@color/navy_ink"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/control_panel_background"
        android:orientation="vertical"
        android:padding="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topPanel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Sprechtempo"
                android:src="@drawable/ic_sound" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:text="SPRECHTEMPO"
                android:textColor="@color/cream"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:max="100"
            android:progress="48"
            android:progressBackgroundTint="@color/navy_light"
            android:progressTint="@color/gold"
            android:thumbTint="@color/gold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Lautstärke"
                android:src="@drawable/ic_sound" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:text="LAUTSTÄRKE"
                android:textColor="@color/cream"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:max="100"
            android:progress="80"
            android:progressBackgroundTint="@color/navy_light"
            android:progressTint="@color/sky"
            android:thumbTint="@color/sky" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Figurenstimme"
                android:src="@drawable/ic_volume" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:text="FIGURENSTIMME"
                android:textColor="@color/cream"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/soundsToggleButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-rounded"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="STIMME WÄHLEN"
            android:textColor="@color/navy_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gold"
            app:cornerRadius="11dp"
            app:icon="@drawable/ic_volume"
            app:iconGravity="textStart"
            app:iconPadding="5dp"
            app:iconSize="14dp"
            app:iconTint="@color/navy_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="PAUSE"
                android:textColor="@color/navy_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/gold"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_pause"
                app:iconGravity="textStart"
                app:iconPadding="5dp"
                app:iconSize="14dp"
                app:iconTint="@color/navy_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeatButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="NOCHMAL"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blue"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_repeat"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
