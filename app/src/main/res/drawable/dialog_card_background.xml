<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#8A071332" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/white"
                android:startColor="@color/cream" />
            <stroke
                android:width="3dp"
                android:color="@color/blue_bright" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
